# Volunteer API
DATABASE_URL=postgresql://postgres:password@localhost:5432/volunteer_platform
ANTHROPIC_API_KEY=replace-with-provider-api-key
CORS_ORIGINS=http://localhost:3000
HOST=127.0.0.1
RATE_LIMIT_MAX=100

# Public browser-to-volunteer API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only private cloud billing connection
CLOUD_BILLING_API_URL=https://private-cloud-billing.example
CLOUD_BILLING_API_KEY=replace-with-a-long-random-value
